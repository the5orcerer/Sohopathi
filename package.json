{
  "name": "education-platform-backend",
  "version": "1.0.0",
  "description": "Multi-tenant, permission-driven, module-based school management platform backend",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "build:frontend": "cd frontend && npm run build",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "preview:frontend": "cd frontend && npm run preview",
    "seed:db": "DATABASE_URL=\"${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:5433/education-platform}\" tsx src/core/init-db.ts",
    "seed:env": "tsx src/core/init-db.ts",
    "db:push": "tsx src/core/db-push.ts",
    "test": "vitest run --fileParallelism false --maxConcurrency 1 --pool=threads --poolOptions.threads.singleThread --testTimeout 60000 --hookTimeout 60000"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@sentry/node": "^10.72.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "pino": "^9.2.0",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^5.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "pino-pretty": "^11.2.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.0",
    "vitest": "^1.6.0"
  }
}
