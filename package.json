{
  "name": "education-platform-backend",
  "version": "1.0.0",
  "description": "Multi-tenant, permission-driven, module-based school management platform backend",
  "main": "dist/server.js",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "setup:fresh": "tsx scripts/setup.ts --fresh",
    "setup:hosts": "tsx scripts/setup-hosts.ts",
    "dev": "tsx scripts/dev.ts",
    "dev:backend": "tsx watch src/server.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:home": "cd home && npm run dev",
    "build": "tsc && npm run build:home && npm run build:frontend",
    "build:backend": "tsc",
    "build:frontend": "cd frontend && npm run build",
    "build:home": "cd home && npm run build",
    "start": "node dist/server.js",
    "db:init": "tsx db/init.ts",
    "db:fresh": "tsx db/init.ts --fresh",
    "db:up": "tsx scripts/db-control.ts up",
    "db:down": "tsx scripts/db-control.ts down",
    "seed:db": "DATABASE_URL=\"${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:5433/biddyapith_dev}\" tsx db/init.ts",
    "test": "vitest run --no-file-parallelism --maxWorkers 1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@sentry/node": "^10.72.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "pino": "^9.2.0",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^5.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "pino-pretty": "^11.2.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.0",
    "vitest": "^1.6.0"
  }
}
